{
  "name": "@openevents/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.migrate.config.ts",
    "test:integration": "vitest run --config=vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.6.0",
    "pg": "8.23.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
